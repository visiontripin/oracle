# Secret key for JWT (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-generate-a-strong-secret-key-min-32-chars
JWT_EXPIRE_MINUTES=120

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_VERSION=1.0.0

# First admin user (auto-created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Database (SQLite default; postgres example below)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# DATABASE_URL=postgresql+asyncpg://bot:secret@localhost:5432/botdb

PLUGINS_DIR=./plugins
BACKUP_DIR=./backups
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (tunnel URL goes here)
CORS_ORIGINS=http://localhost:3000

# Optional: auto-register a local LLM provider on first start
# (otherwise configure it in the app's "Local LLM" tab)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
